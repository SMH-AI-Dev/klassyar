{
  "name": "klassyar",
  "private": true,
  "version": "1.6.0",
  "homepage": "https://SMH-AI-Dev.github.io/klassyar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "postbuild": "copy /Y dist\\index.html dist\\404.html >nul",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist --dotfiles",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "npm run build && electron-builder",
    "build:android": "vite build --base=/"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/core": "^7.6.9",
    "@hello-pangea/dnd": "^16.5.0",
    "@react-pdf/renderer": "^4.3.1",
    "@tanstack/react-query": "^5.14.0",
    "axios": "^1.6.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.294.0",
    "nodemon": "^3.1.14",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.20.0",
    "react-to-print": "^3.2.0",
    "sql.js": "^1.13.0",
    "tailwind-merge": "^2.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.32",
    "sharp": "^0.35.4",
    "tailwindcss": "^3.3.6",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^5.0.8"
  },
  "main": "electron/main.js",
  "description": "کلاسیار - پلتفرم بازیهای آموزشی",
  "author": "SMH-AI-Dev",
  "build": {
    "appId": "com.klassyar.app",
    "productName": "Klassyar",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!electron/resources/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Klassyar-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Klassyar-Portable-${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.png",
      "category": "Education",
      "maintainer": "SMH-AI-Dev",
      "artifactName": "Klassyar-${version}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/resources/icon.png",
      "category": "public.app-category.education"
    }
  }
}
